# DAS ARCHIV — Zugangsdaten
#
# Diese Datei nach ".env" kopieren und die Werte eintragen.
# ".env" ist in .gitignore und wird nicht veroeffentlicht.
#
# Danach die Bruecke neu starten:  node scripts/bridge.mjs
# Pruefen:                          node scripts/check-providers.mjs

# Welcher Anbieter benutzt werden soll: gemini | groq | openrouter | cloudflare
# Ohne Angabe nimmt die Bruecke den ersten Anbieter mit Schluessel.
ARCHIV_PROVIDER=

# --- Google Gemini -------------------------------------------------------
# Schluessel: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Groq ----------------------------------------------------------------
# Schluessel: https://console.groq.com/keys
GROQ_API_KEY=

# --- OpenRouter ----------------------------------------------------------
# Schluessel: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Cloudflare Workers AI ----------------------------------------------
# Token:     https://dash.cloudflare.com/profile/api-tokens (Recht: Workers AI)
# Konto-ID:  in der Cloudflare-URL sichtbar, z. B. dash.cloudflare.com/<ID>
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Optional: Modell ueberschreiben ------------------------------------
# ARCHIV_MODEL=gemini-2.0-flash

# --- Optional: eigener Endpunkt (Ollama, LM Studio, OpenRouter, ...) -----
# ARCHIV_API_KEY=
# ARCHIV_BASE_URL=http://localhost:11434/v1
# ARCHIV_MODEL=llama3.1:8b
